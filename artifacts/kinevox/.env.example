# ==============================================================================
# KinevoX — Firebase Environment Configuration
# ==============================================================================
# Copy this file to `.env` in the same directory (artifacts/kinevox/.env)
# and replace the placeholders with your Firebase project credentials.
#
# How to get these values:
# 1. Open Google Firebase Console: https://console.firebase.google.com/
# 2. Create or select your project (e.g., "kinevox-app")
# 3. Go to Project Settings -> General -> Your apps -> Web app (</>)
# 4. Copy the `firebaseConfig` object values into the variables below:

VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-kinevox-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-kinevox-project
VITE_FIREBASE_STORAGE_BUCKET=your-kinevox-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional: Set to true if you are running the local Firebase emulator suite
# VITE_USE_FIREBASE_EMULATORS=false
